<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        title="Books Library"
        class="SapUiContentPadding"
        contentHeight="300px"
        contentWidth="400px"
        resizable="true"
        draggable="true"
    >
        <Table
            id="booksTabVH"
            items="{book>/BooksSet}"
        >
            <columns>
                <Column>
                    <Text text="Title" />
                </Column>
                <Column>
                    <Text text="Author" />
                </Column>
            </columns>
            <items>
                <ColumnListItem
                    type="Active"
                    press=".onBooksRowPress"
                >
                    <cells>
                        <Text text="{book>title}" />
                        <Text text="{book>author}" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
        <endButton>
            <Button
                text="Cancel"
                press=".onCancelBookVH"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
